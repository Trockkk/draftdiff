# Copy to .env.local and fill in. Never commit .env.local.
# Without a key the app still works: the verdict uses the statistical model only.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-opus-5-5
ANTHROPIC_MODEL=
# Room server for online games. Local: localhost:1999. Production: draftdiff.<your-subdomain>.workers.dev
NEXT_PUBLIC_PARTY_HOST=localhost:1999
